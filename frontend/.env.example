# ParkMe Frontend Environment Configuration

# Backend API URL (Live Vercel backend for all devices and networks)
EXPO_PUBLIC_API_URL=https://parkme-backend.vercel.app

# Google OAuth Client IDs (PUBLIC - never put client secrets here)
# Web Client ID (used by Android & backend verification)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
# iOS Client ID (optional if iOS client is configured with custom URL scheme)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
