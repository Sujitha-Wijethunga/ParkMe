# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ── dependencies ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Expo ────────────────────────────────────────────────────────
.expo/
frontend/.expo/
dist/
web-build/
expo-env.d.ts
frontend/expo-env.d.ts

# ── Native ──────────────────────────────────────────────────────
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# ── Metro ───────────────────────────────────────────────────────
.metro-health-check*

# ── Debug ───────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*

# ── macOS ───────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Environment variables (never commit real credentials) ────────
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ── TypeScript ──────────────────────────────────────────────────
*.tsbuildinfo

# ── Generated native folders ────────────────────────────────────
/ios
/android
frontend/ios
frontend/android
